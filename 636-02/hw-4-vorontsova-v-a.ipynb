"source": [
"# Анализ данных датасета California Housing и решение задачи регрессии\n",
"Выполнение практической работы №4"
]
},
{
"cell_type": "code",
"execution_count": 1,
"id": "2b3c4d5e",
"metadata": {},
"outputs": [],
"source": [
"import pandas as pd\n",
"import seaborn as sns\n",
"import matplotlib.pyplot as plt\n",
"\n",
"from sklearn.datasets import fetch_california_housing\n",
"from sklearn.model_selection import train_test_split\n",
"from sklearn.preprocessing import StandardScaler\n",
"from sklearn.linear_model import LinearRegression, Ridge, Lasso\n",
"from sklearn.ensemble import RandomForestRegressor\n",
"from sklearn.metrics import mean_squared_error"
]
},
{
"cell_type": "markdown",
"id": "3c4d5e6f",
"metadata": {},
"source": [
"## 1. Первичный анализ и осмотр датасета (EDA)"
]
},
{
"cell_type": "code",
"execution_count": 2,
"id": "4d5e6f7a",
"metadata": {},
"outputs": [],
"source": [
"housing_data = fetch_california_housing(as_frame=True)\n",
"df = housing_data.frame\n",
"\n",
"print("Пример первых 5 записей:")\n",
"display(df.head())\n",
"\n",
"print("\nСводка о структуре данных:")\n",
"df.info()\n",
"print("\nОсновные статистические показатели:")\n",
"display(df.describe())"
]
},
{
"cell_type": "code",
"execution_count": 3,
"id": "5e6f7a8b",
"metadata": {},
"outputs": [],
"source": [
"plt.figure(figsize=(9, 7))\n",
"sns.heatmap(df.corr(), annot=True, cmap='cividis', fmt='.2f', linewidths=0.3)\n",
"plt.title('Корреляционная матрица признаков')\n",
"plt.show()"
]
},
{
"cell_type": "markdown",
"id": "6f7a8b9c",
"metadata": {},
"source": [
"## 2. Разделение и нормализация выборок"
]
},
{
"cell_type": "code",
"execution_count": 4,
"id": "7a8b9c0d",
"metadata": {},
"outputs": [],
"source": [
"X = df.drop(columns=['MedHouseVal'])\n",
"y = df['MedHouseVal']\n",
"\n",
"# Задаем индивидуальный случайный параметр и объем тестов 25%\n",
"X_train, X_test, y_train, y_test = train_test_split(\n",
"    X, y, test_size=0.25, random_state=100\n",
")\n",
"\n",
"scaler = StandardScaler()\n",
"X_train_scaled = scaler.fit_transform(X_train)\n",
"X_test_scaled = scaler.transform(X_test)"
]
},
{
"cell_type": "markdown",
"id": "8b9c0d1e",
"metadata": {},
"source": [
"## 3. Сравнение алгоритмов регрессии"
]
},
{
"cell_type": "code",
"execution_count": 5,
"id": "9c0d1e2f",
"metadata": {},
"outputs": [],
"source": [
"regressors = {\n",
"    'Линейная регрессия': LinearRegression(),\n",
"    'Greedy Ridge': Ridge(alpha=1.5),\n",
"    'Lasso Регрессия': Lasso(alpha=0.01),\n",
"    'Случайный лес': RandomForestRegressor(n_estimators=100, random_state=100)\n",
"}\n",
"\n",
"metrics_summary = {}\n",
"for title, model in regressors.items():\n",
"    if title in ['Линейная регрессия', 'Greedy Ridge', 'Lasso Регрессия']:\n",
"        model.fit(X_train_scaled, y_train)\n",
"        predictions = model.predict(X_test_scaled)\n",
"    else:\n",
"        model.fit(X_train, y_train)\n",
"        predictions = model.predict(X_test)\n",
"        \n",
"    mse_score = mean_squared_error(y_test, predictions)\n",
"    metrics_summary[title] = mse_score\n",
"    print(f'Модель «{title}» — MSE = {mse_score:.4f}')"
]
},
{
"cell_type": "markdown",
"id": "0d1e2f3a",
"metadata": {},
"source": [
"## 4. Итоговые наблюдения\n",
"\n",
"- Линейные методы (Linear Regression и Ridge) выявили похожую точечную точность.\n",
"- Регуляризация Lasso проявила себя чувствительной к масштабу признаков при изменении параметра alpha.\n",
"- Наилучшую точность прогноза показала ансамблевая модель Случайного леса, снизив значение среднеквадратичной ошибки благодаря способности анализировать нелинейную структуру данных."
]
}
