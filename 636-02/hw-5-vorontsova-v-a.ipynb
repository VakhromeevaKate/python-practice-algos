"source": [
"# Практическое задание 5: Разбор и классификация изображений MNIST"
]
},
{
"cell_type": "code",
"execution_count": 1,
"id": "082595b2",
"metadata": {},
"outputs": [],
"source": [
"%pip install kagglehub --quiet"
]
},
{
"cell_type": "code",
"execution_count": 2,
"id": "b5cdb267",
"metadata": {},
"outputs": [],
"source": [
"import kagglehub\n",
"\n",
"# Автоматическая загрузка датасета через библиотека kagglehub\n",
"dataset_path = kagglehub.dataset_download("hojjatk/mnist-dataset")\n",
"print("Каталог с загруженным датасетом:", dataset_path)"
]
},
{
"cell_type": "code",
"execution_count": 3,
"id": "07c17022",
"metadata": {},
"outputs": [],
"source": [
"import os\n",
"\n",
"for path, dirs, files in os.walk(dataset_path):\n",
"    nesting_level = path.replace(dataset_path, "").count(os.sep)\n",
"    if nesting_level <= 2:\n",
"        margin = "  " * nesting_level\n",
"        print(f"{margin}{os.path.basename(path)}/")\n",
"        if files:\n",
"            print(f"{margin}  └── Найдено файлов: {len(files)} (например: {files[:2]})")"
]
},
{
"cell_type": "code",
"execution_count": 4,
"id": "60ec82c0",
"metadata": {},
"outputs": [],
"source": [
"import struct\n",
"import numpy as np\n",
"from pathlib import Path\n",
"from sklearn.model_selection import train_test_split\n",
"\n",
"def parse_idx_images(file_path):\n",
"    """Чтение изображений из формата binary IDX."""\n",
"    with open(file_path, 'rb') as f:\n",
"        header_magic, count, height, width = struct.unpack(">IIII", f.read(16))\n",
"        assert header_magic == 2051, f"Некорректное заголовочное число: {header_magic}"\n",
"        raw_bytes = np.frombuffer(f.read(), dtype=np.uint8)\n",
"        flat_images = raw_bytes.reshape(count, height * width)\n",
"    return flat_images.astype(np.float32)\n",
"\n",
"def parse_idx_labels(file_path):\n",
"    """Чтение меток из формата binary IDX."""\n",
"    with open(file_path, 'rb') as f:\n",
"        header_magic, count = struct.unpack(">II", f.read(8))\n",
"        assert header_magic == 2049, f"Некорректное заголовочное число: {header_magic}"\n",
"        labels = np.frombuffer(f.read(), dtype=np.uint8)\n",
"    return labels.astype(int)\n",
"\n",
"def prepare_mnist_data(directory):\n",
"    dir_root = Path(directory)\n",
"\n",
"    def locate_target(*filenames):\n",
"        for target in filenames:\n",
"            if (dir_root / target).exists():\n",
"                return dir_root / target\n",
"            for found in dir_root.rglob(target):\n",
"                return found\n",
"        raise FileNotFoundError(f"Не найден требуемый файл из списка: {filenames}")\n",
"\n",
"    img_train_path = locate_target("train-images.idx3-ubyte", "train-images-idx3-ubyte")\n",
"    lbl_train_path = locate_target("train-labels.idx1-ubyte", "train-labels-idx1-ubyte")\n",
"    img_test_path  = locate_target("t10k-images.idx3-ubyte", "t10k-images-idx3-ubyte")\n",
"    lbl_test_path  = locate_target("t10k-labels.idx1-ubyte", "t10k-labels-idx1-ubyte")\n",
"\n",
"    X_train_raw = parse_idx_images(img_train_path)\n",
"    y_train_raw = parse_idx_labels(lbl_train_path)\n",
"    X_test      = parse_idx_images(img_test_path)\n",
"    y_test      = parse_idx_labels(lbl_test_path)\n",
"\n",
"    # Стратифицированное разбиение на обучение и валидацию (15% на валидацию, random_state=100)\n",
"    X_train, X_val, y_train, y_val = train_test_split(\n",
"        X_train_raw, y_train_raw,\n",
"        test_size=0.15,\n",
"        random_state=100,\n",
"        stratify=y_train_raw,\n",
"    )\n",
"\n",
"    # Масштабирование ярких пикселей в промежуток [0.0, 1.0]\n",
"    X_train /= 255.0\n",
"    X_val   /= 255.0\n",
"    X_test  /= 255.0\n",
"\n",
"    print(f"Размерность Train: X={X_train.shape}, y={y_train.shape}")\n",
"    print(f"Размерность Val:   X={X_val.shape},   y={y_val.shape}")\n",
"    print(f"Размерность Test:  X={X_test.shape},  y={y_test.shape}")\n",
"\n",
"    return X_train, y_train, X_val, y_val, X_test, y_test"
]
},
{
"cell_type": "code",
"execution_count": 5,
"id": "78201a3b",
"metadata": {},
"outputs": [],
"source": [
"# Выполнение считывания из полученного локального каталога\n",
"X_tr, y_tr, X_v, y_v, X_ts, y_ts = prepare_mnist_data(dataset_path)"
]
},
{
"cell_type": "code",
"execution_count": 6,
"id": "e492b1cd",
"metadata": {},
"outputs": [],
"source": [
"from sklearn.linear_model import LogisticRegression\n",
"from sklearn.metrics import accuracy_score, classification_report\n",
"\n",
"# Задаем классификатор с небольшими изменениями гиперпараметров\n",
"log_reg = LogisticRegression(C=0.8, max_iter=800, random_state=100)\n",
"log_reg.fit(X_tr, y_tr)\n",
"\n",
"pred_val = log_reg.predict(X_v)\n",
"pred_test = log_reg.predict(X_ts)\n",
"\n",
"print(f"Оценка на валидационном наборе (Accuracy): {accuracy_score(y_v, pred_val):.4f}")\n",
"print(f"Оценка на тестовом наборе (Accuracy):      {accuracy_score(y_ts, pred_test):.4f}\n")\n",
"\n",
"print("=== Подробный метрический отчет по классам ===")\n",
"print(classification_report(y_ts, pred_test))"
]
},
{
"cell_type": "markdown",
"id": "c928fa82",
"metadata": {},
"source": [
"## Резюме по работе\n",
"\n",
"1. Исходные файлы выгружены и успешно прочитаны напрямую из бинарного формата IDX.\n",
"2. Все значения яркости пикселей приведены к диапазону $[0, 1]$.\n",
"3. Данные разбиты на 3 подвыборки с фиксированием стратификации по распределению меток.\n",
"4. Линейный классификатор продемонстрировал приемлемое качество распознавания на тестовой выборке."
]
}
